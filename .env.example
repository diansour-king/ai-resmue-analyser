# Copy to .env before `make dev`. Every value here is a development default and is
# safe to commit; production values come from the deploy platform, never from a file.

POSTGRES_USER=careerlayer
POSTGRES_PASSWORD=careerlayer
POSTGRES_DB=careerlayer

# Host-side ports are overridable because a developer machine often already has
# Postgres or Redis bound to the default port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=3000

MINIO_ROOT_USER=careerlayer
MINIO_ROOT_PASSWORD=careerlayer-dev-secret
S3_BUCKET=careerlayer-resumes

# development returns the sign-in link in the API response and logs it, so the flow works
# with no mail server. Any other value withholds it, so a deployment that forgets to set
# this fails closed.
ENVIRONMENT=development

# Leave blank to follow ENVIRONMENT (Secure off in development). Set to true on an HTTPS
# deployment that still needs ENVIRONMENT=development for the returned sign-in link.
COOKIE_SECURE=

# LLM provider (Phase 3, architecture sections 7.1 and 12.2). The default is `disabled`:
# a fresh clone makes zero provider calls and every LLM endpoint returns a structured
# `llm_disabled` error until an operator sets LLM_DATA_PROCESSING_MODE and a key.
#   disabled       - no calls, ever
#   fixtures_only  - calls allowed only for documents marked is_fixture=true
#   production     - calls allowed for real documents (requires a recorded Gate 1 attestation)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_FALLBACK_MODEL=claude-opus-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_INFERENCE_GEO=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS_EXTRACTION=4096
LLM_MAX_OUTPUT_TOKENS_MATCHING=8192
LLM_CACHE_TTL=5m
LLM_DATA_PROCESSING_MODE=disabled
LLM_PRIVACY_ATTESTATION_ID=
LLM_PRIVACY_VERIFIED_AT=
