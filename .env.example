# Copy to .env before `make dev`. Every value here is a development default and is
# safe to commit; production values come from the deploy platform, never from a file.

POSTGRES_USER=careerlayer
POSTGRES_PASSWORD=careerlayer
POSTGRES_DB=careerlayer

# Host-side ports are overridable because a developer machine often already has
# Postgres or Redis bound to the default port.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000

MINIO_ROOT_USER=careerlayer
MINIO_ROOT_PASSWORD=careerlayer-dev-secret
S3_BUCKET=careerlayer-resumes
